# Linxi AI gateway - AWS deployment settings (no secrets in this file).
REGION=ap-southeast-1
APP_STACK=linxi-app
EDGE_STACK=linxi-edge
ECR_REPO=linxi-api
BASE_VERSION=v1.0.0-rc.51

# Network: the region's default VPC; the stack adds two private subnets and a NAT gateway.
VPC_ID=vpc-xxxxxxxx
PUBLIC_SUBNET_IDS=subnet-aaaa,subnet-bbbb
PRIVATE_A_CIDR=172.31.64.0/20
PRIVATE_A_AZ=ap-southeast-1a
PRIVATE_B_CIDR=172.31.80.0/20
PRIVATE_B_AZ=ap-southeast-1b

# ALB origin hostname (Route53 zone in this account) - CloudFront connects to it over HTTPS.
ORIGIN_HOST=linxi-origin.example.com
ORIGIN_ZONE_ID=ZXXXXXXXXXXXXX

# CloudFront
ALIASES=linxi.ai,www.linxi.ai,api.linxi.ai
VIEWER_CERT_ARN=arn:aws:acm:us-east-1:111122223333:certificate/xxxxxxxx
ORIGIN_READ_TIMEOUT=180
# Aliases that live in a Route53 zone of this account get A/AAAA records automatically (optional).
EDGE_ZONE_ID=
EDGE_ZONE_HOSTS=
